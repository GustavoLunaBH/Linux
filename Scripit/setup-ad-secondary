    # Etapa 1: Configurar DNS para internet
    configure_dns_internet
    
    # Coletar informacoes
    collect_user_info
    
    log_info "Inicio: $(date)"
    log_info "Log: $LOG_FILE"
    echo ""
    
    # Executar etapas
    check_connectivity
    configure_ssh_root
    setup_autocomplete
    configure_hostname_dns
    install_packages
    join_domain
    start_services
    check_replication
    create_aux_scripts
    
    # Resumo final
    show_summary
    
    if confirm "Deseja reiniciar o servidor agora?"; then
        log_info "Reiniciando em 5 segundos..."
        sleep 5
        reboot
    else
        log_info "Lembre-se de reiniciar o servidor depois."
        log_info "Execute: reboot"
    fi
}

# =============================================================================
# EXECUTAR
# =============================================================================

main "$@"
